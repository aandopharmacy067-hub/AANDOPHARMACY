# Firebase web configuration. These values identify your Firebase project; they are not server secrets.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=replace-with-firebase-app-id
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Never add Paystack's secret key to a VITE_* variable or frontend environment file.
# Configure it as a Firebase Functions secret instead:
# firebase functions:secrets:set PAYSTACK_SECRET_KEY
# mNotify key is also server-only. Configure it as a Firebase Functions secret:
# firebase functions:secrets:set SMS_API_KEY

