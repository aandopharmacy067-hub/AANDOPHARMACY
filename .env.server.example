# Copy to .env.server for local development. Never put secrets in .env.local or VITE_* variables.
# Deploy providers should set these as private server environment variables.
PORT=3001
PUBLIC_APP_URL=http://localhost:5173
FIREBASE_PROJECT_ID=a-o-pharmacy
PAYSTACK_SECRET_KEY=replace-with-paystack-test-secret-key
MNOTIFY_API_KEY=replace-with-mnotify-server-api-key
MNOTIFY_SENDER_ID=AO PHARMACY

# Provide Firebase Admin credentials only to the server.
# Preferred on a host: mount a service-account JSON file and set its path here.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
# Alternatively, set FIREBASE_SERVICE_ACCOUNT_JSON to the full service-account JSON
# as a private host secret and remove the GOOGLE_APPLICATION_CREDENTIALS line.
